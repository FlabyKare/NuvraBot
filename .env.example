# Обязательно: токен нового бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Публичный HTTPS URL этого приложения без завершающего слеша
PUBLIC_URL=https://brain.example.com

# Необязательно: включает embeddings, AI-поиск, суммаризацию и распознавание вложений
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEXT_MODEL=gpt-5.4-nano
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
RECOGNITION_MAX_BYTES=20000000

# Приложение
APP_ENV=production
DEV_MODE=false
RUN_BOT=true
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/second_brain.sqlite3
# Railway создаёт эту переменную автоматически после подключения Volume к /app/data.
# RAILWAY_VOLUME_MOUNT_PATH=/app/data
# Для Docker-образа с non-root USER добавьте в Railway Variables: RAILWAY_RUN_UID=0
FREE_ITEMS_LIMIT=500
REMINDER_POLL_SECONDS=30

# PRO-подписка Telegram Stars
PRO_PRICE_STARS=299
PRO_SUBSCRIPTION_DAYS=30
SUPPORT_USERNAME=your_support_username
TERMS_URL=https://example.com/terms
